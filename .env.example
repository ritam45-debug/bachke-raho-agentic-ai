# Copy to backend/.env (local) or set in your host's secret manager. Never commit real values.
ENVIRONMENT=development            # development | test | production
DATABASE_URL=sqlite:///./bachke_dev.db
# Production (Supabase / managed Postgres) — the API must connect as a NON-owner, non-superuser role so RLS applies:
# DATABASE_URL=postgresql+psycopg://bachke_app:<password>@<host>:5432/postgres
JWT_SECRET=                         # required in production; generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_ON_STARTUP=true
# Phase 2 — leave empty until then. AI features stay off without it.
ANTHROPIC_API_KEY=
AI_EXTERNAL_PROCESSING_DEFAULT=false
